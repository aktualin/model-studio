# AI provider selection. "anthropic" (default) or "modelstudio".
AI_PROVIDER=anthropic

# Anthropic Messages API (or any Anthropic-compatible endpoint, e.g. an
# Aliyun Model Studio Token Plan base URL). Base URL defaults to the real
# Anthropic API when left unset.
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=
# Model id available on your account, e.g. claude-sonnet-5-5
ANTHROPIC_MODEL=

# Only used when AI_PROVIDER=modelstudio. Key must look like "sk-...", not "sk-sp-...".
MODEL_STUDIO_API_KEY=
MODEL_STUDIO_BASE_URL=
MODEL_STUDIO_MODEL=

# Only used when AI_PROVIDER=openai. Base URL defaults to https://api.openai.com.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# NextAuth — single-admin credentials login guarding /admin/*.
# Generate AUTH_SECRET with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: force every proxied request's "model" field to this id before
# forwarding upstream (useful when the real plan only serves one model).
UPSTREAM_MODEL_OVERRIDE=
# Optional: clamp "max_tokens" to this value when UPSTREAM_MODEL_OVERRIDE is set.
UPSTREAM_MAX_OUTPUT_TOKENS=

# Optional: Zilliz Cloud (Milvus) cluster used as a best-effort semantic
# cache for /api/v1/messages. Leave unset to disable caching entirely.
ZILLIZ_ENDPOINT=
ZILLIZ_TOKEN=
ZILLIZ_COLLECTION=model_studio_semantic_cache_v1
SEMANTIC_CACHE_THRESHOLD=0.93

# Supabase Postgres — pooled connection (port 6543, pgbouncer) for the app runtime.
DATABASE_URL="postgresql://postgres:password@db.xxxxx.supabase.co:6543/postgres?pgbouncer=true"

# Supabase Postgres — direct connection (port 5432) for Prisma Migrate.
DIRECT_URL="postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres"
