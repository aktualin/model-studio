# AI provider selection. "anthropic" (default) or "modelstudio".
AI_PROVIDER=anthropic

# Anthropic Messages API
ANTHROPIC_API_KEY=
# Model id available on your account, e.g. claude-sonnet-5-5
ANTHROPIC_MODEL=

# Only used when AI_PROVIDER=modelstudio. Key must look like "sk-...", not "sk-sp-...".
MODEL_STUDIO_API_KEY=
MODEL_STUDIO_BASE_URL=
MODEL_STUDIO_MODEL=

# Supabase Postgres — pooled connection (port 6543, pgbouncer) for the app runtime.
DATABASE_URL="postgresql://postgres:password@db.xxxxx.supabase.co:6543/postgres?pgbouncer=true"

# Supabase Postgres — direct connection (port 5432) for Prisma Migrate.
DIRECT_URL="postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres"
